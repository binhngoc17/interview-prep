# Copy this file to .env.local and fill in the values.
# Next.js reads .env.local. Do not commit that file.
# On Vercel, set the same names in Project → Settings → Environment Variables.

# At least 16 characters. Required in production so login sessions stay valid across restarts.
AUTH_SECRET=

# Supabase → Project Settings → API.
# Use the project URL and the secret key (starts with sb_secret_). The secret key bypasses row level security.
# Never use the publishable key here, and never prefix these with NEXT_PUBLIC_.
# Both set: user data goes to Supabase. Both empty in development: local files under data/.
# Production requires both. Setting only one is an error.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=

# Login email. Vercel does not send mail itself.
# Install Resend from the Vercel Marketplace. That adds RESEND_API_KEY to the project.
# EMAIL_FROM must be a sender you verified in Resend, for example "Interview Prep <login@yourdomain.com>".
# When both are set, the login code is emailed. When both are empty in development, the code is shown on the login screen.
# Production requires both.
RESEND_API_KEY=
EMAIL_FROM=
